<Window x:Class="KCRV_Statistics.UI.Views.EntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:KCRV_Statistics.UI.ViewModels"
        mc:Ignorable="d"
        Title="KCRV Statistics v 0.0.0.8" Height="455" Width="765" ResizeMode="NoResize">
    <Window.DataContext>
        <local:EntryWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <!--#region Поиск -->
        <Label Margin="226,20,0,0" Height="30" Width="200" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Найти в списке:" />
        <TextBox Text="{Binding Query}" Margin="230,50,0,0" Height="20" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Command="{Binding Search}" Margin="360, 30, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Найти" Height="40" Width="80"/>
        <Button Command="{Binding Reset}" Margin="450, 30, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="40" Width="80">
            <TextBlock TextAlignment="Center">Сбросить<LineBreak/>результаты</TextBlock>
        </Button>
        <!--#endregion-->

        <!-- #region Список файлов и директорий -->
        <ListView x:Name="DirectoryDataEntitiesList" ItemsSource="{Binding DirectoryDataEntities}" Margin="10,30,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="345" Width="210">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                    <i:InvokeCommandAction Command="{Binding SelectDirectoryCommand}" CommandParameter="{Binding SelectedItem, ElementName=DirectoryDataEntitiesList}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Имя директории" Width="135" DisplayMemberBinding="{Binding DirectoryName}"/>
                    <GridViewColumn Header="Выбрать" Width="65">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <CheckBox IsChecked="{Binding IsChoised}" HorizontalAlignment="Center" IsEnabled="False"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <!--Button Command="{Binding CurrentDirectories}" Margin="10, 335, 0, 0"  Height="25" Width="210" Content="Текущие папки" HorizontalAlignment="Left" VerticalAlignment="Top"/-->
        <ListView x:Name="FileDatasList" ItemsSource="{Binding FileDatas}" Margin="230,85,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="245" Width="300">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                    <i:InvokeCommandAction Command="{Binding SelectFileCommand}" CommandParameter="{Binding SelectedItem, ElementName=FileDatasList}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="30" DisplayMemberBinding="{Binding ID}" />
                    <GridViewColumn Header="Папка" Width="105" DisplayMemberBinding="{Binding Directory}" />
                    <GridViewColumn Header="Имя файла" Width="160" DisplayMemberBinding="{Binding FileName}"/>
                </GridView>
            </ListView.View>
        </ListView>
        
        <!--#endregion-->

        <!--#region Выбор логики работы со списком файлов -->
        <Label Margin="227, 333, 0, 0" Width="240" HorizontalAlignment="Left" VerticalAlignment="Top" Content="При нажатии на элемент списка файлов:" />
        <CheckBox IsChecked="{Binding MustBeViewed}" Margin="230, 360, 0, 0" Content="Отобразить данные" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10"/>
        <CheckBox IsChecked="{Binding MustToID}" Margin="350, 360, 0, 0" Content="Заполнить ID" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10"/>
        <CheckBox IsChecked="{Binding MustBeReaded}" Margin="445, 360, 0, 0" Content="Открыть файл" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10"/>
        <!--#endregion-->

        <!--#region Выбор раздела -->
        <Label Margin="80,384,0,0" Width="200" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Отобразить файлы формата:" />
        <CheckBox IsChecked="{Binding XLSX_Check}" Margin="260,390,0,0" Content="XLSX" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <CheckBox IsChecked="{Binding JSON_Check}" Margin="330,390,0,0" Content="JSON" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <CheckBox IsChecked="{Binding CSV_Check}"  Margin="400,390,0,0" Content="CSV" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <CheckBox IsChecked="{Binding TXT_Check}"  Margin="470,390,0,0" Content="TXT" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <!--#endregion-->

        <!--#region Управление и описание программы -->
        <Label Margin="546,23,0,0" Height="30" Width="150" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Открыть файл по ID:" />
        <TextBox x:Name="ID_Field" Text="{Binding ID_Field}" Margin="550,50,0,0" Height="20" Width="180" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Command="{Binding FindElementByID_Command}" Margin="550, 83, 0, 0"  Height="25" Width="180" Content="Расчитать" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Command="{Binding ShowVisualization}" Margin="550, 117, 0, 0" Height="25" Width="180" Content="Визуализация данных" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Command="{Binding ShortDescription}" Margin="550, 180, 0, 0" Height="30" Width="180" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock TextAlignment="Center">Краткое описание окон<LineBreak/>Расчитать / Визуализация данных</TextBlock>
        </Button>
        <Button Command="{Binding SearchInfo}" Margin="550, 220, 0, 0" Height="30" Width="180" FontSize="10" Content="Использование поиска" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Command="{Binding ProgrammCycleInfo}" Margin="550, 260, 0, 0" Height="30" Width="180" FontSize="10" Content="Цикл использования программы" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Command="{Binding Help}" Margin="550, 300, 0, 0" Height="30" Width="180" FontSize="10" Content="Справка по программе" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <!--#endregion-->
        
    </Grid>
</Window>
